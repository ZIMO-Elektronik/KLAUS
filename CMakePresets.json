{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "include": [],
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "displayName": "Base Preset",
            "description": "Base Preset providing base config",
            "generator": "Ninja",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_PARALLEL_LEVEL": "16"
            }
        },
        {
            "name": "debug_base",
            "hidden": true,
            "displayName": "Debug Base Preset",
            "description": "Debug Base Preset providing base config for DEBUG builds",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release_base",
            "hidden": true,
            "displayName": "Release Base Preset",
            "description": "Release Base Preset providing base config for RELEASE builds",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Configure debug build",
            "inherits": "debug_base"
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Configure release build",
            "inherits": "release_base"
        },
        {
            "name": "debug_osx",
            "displayName": "Debug OSX",
            "description": "Configure debug build for OSX",
            "inherits": "debug_base",
            "cacheVariables": {
                "LIBULF_BACKEND_LIBSERIALPORT": "OFF",
                "LIBULF_BACKEND_LIBUSB": "ON"
            }
        },
        {
            "name": "release_osx",
            "displayName": "Release OSX",
            "description": "Configure release build for OSX",
            "inherits": "release_base",
            "cacheVariables": {
                "LIBULF_BACKEND_LIBSERIALPORT": "OFF",
                "LIBULF_BACKEND_LIBUSB": "ON"
            }
        },
        {
            "name": "release_amd64_windows_ci",
            "displayName": "Release AMD64 Windows (CI)",
            "description": "CI specialized preset to deal with vcpkg 'features'",
            "inherits": "release_base",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
            }
        },
        {
            "name": "debug_amd64_windows",
            "displayName": "Debug AMD64 Windows",
            "description": "Cross-Compiled Debug build for Windows on AMD64 architecture",
            "inherits": "debug_base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-cross",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/.vcpkg/triplets/",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw-windows-toolchain.cmake",
                "CPM_libULF_SOURCE": "${sourceDir}/../libULF"
            }
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release AMD64 Windows",
            "description": "Cross-Compiled Release build for Windows on AMD64 architecture",
            "inherits": "release_base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-cross",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/.vcpkg/triplets/",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw-windows-toolchain.cmake",
                "CPM_libULF_SOURCE": "${sourceDir}/../libULF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug Build",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "displayName": "Release Build",
            "configurePreset": "release"
        },
        {
            "name": "release_amd64_windows_ci",
            "displayName": "Release Build for AMD64 Windows (CI)",
            "configurePreset": "release_amd64_windows_ci"
        },
        {
            "name": "debug_amd64_windows",
            "displayName": "Debug Build for AMD64 Windows",
            "configurePreset": "debug_amd64_windows"
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release Build for AMD64 Windows",
            "configurePreset": "release_amd64_windows"
        },
        {
            "name": "debug_osx",
            "displayName": "Debug Build for OSX",
            "configurePreset": "debug_osx"
        },
        {
            "name": "release_osx",
            "displayName": "Release Build for OSX",
            "configurePreset": "release_osx"
        }
    ],
    "packagePresets": [
        {
            "name": "release_linux",
            "displayName": "Release AMD64",
            "configurePreset": "release",
            "generators": [
                "TGZ",
                "AppImage"
            ],
            "variables": {
                "CPACK_PACKAGE_ICON": "zimo_logo.svg"
            }
        },
        {
            "name": "release_windows",
            "displayName": "Release Windows",
            "configurePreset": "release",
            "generators": [
                "ZIP",
                "NSIS"
            ]
        },
        {
            "name": "release_amd64_windows_ci",
            "displayName": "Release AMD64 Windows (CI)",
            "configurePreset": "release_amd64_windows_ci",
            "generators": [
                "ZIP",
                "NSIS"
            ]
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release AMD64 Windows",
            "configurePreset": "release_amd64_windows",
            "generators": [
                "ZIP",
                "NSIS"
            ]
        },
        {
            "name": "release_osx",
            "displayName": "Release OSX",
            "configurePreset": "release_osx",
            "generators": [
                "Bundle"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "build-and-pack-linux",
            "description": "Builds and packs the Linux version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release_linux"
                }
            ]
        },
        {
            "name": "build-and-pack-windows",
            "description": "Builds and packs the Windows version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release_windows"
                }
            ]
        },
        {
            "name": "build-and-pack-amd64-windows-ci",
            "description": "Builds and packs a cross-compiled Windows version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release_amd64_windows_ci"
                },
                {
                    "type": "build",
                    "name": "release_amd64_windows_ci"
                },
                {
                    "type": "package",
                    "name": "release_amd64_windows_ci"
                }
            ]
        },
        {
            "name": "build-and-pack-amd64-windows",
            "description": "Builds and packs a cross-compiled Windows version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release_amd64_windows"
                },
                {
                    "type": "build",
                    "name": "release_amd64_windows"
                },
                {
                    "type": "package",
                    "name": "release_amd64_windows"
                }
            ]
        },
        {
            "name": "build-and-pack-osx",
            "description": "Builds and packs the OSX version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release_osx"
                },
                {
                    "type": "build",
                    "name": "release_osx"
                },
                {
                    "type": "package",
                    "name": "release_osx"
                }
            ]
        }
    ]
}