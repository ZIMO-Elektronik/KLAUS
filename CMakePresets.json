{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "include": [],
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "displayName": "Base Preset",
            "description": "Base Preset providing base config",
            "generator": "Ninja",
            "cacheVariables": {
                "CPM_SOURCE_CACHE": "${sourceDir}/build/.cpm_packages",
                "CMAKE_BUILD_PARALLEL_LEVEL": "16"
            }
        },
        {
            "name": "debug_base",
            "hidden": true,
            "displayName": "Debug Base Preset",
            "description": "Debug Base Preset providing base config for DEBUG builds",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release_base",
            "hidden": true,
            "displayName": "Release Base Preset",
            "description": "Release Base Preset providing base config for RELEASE builds",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug_amd64",
            "displayName": "Debug AMD64",
            "description": "Debug build for AMD64 architecture",
            "binaryDir": "${sourceDir}/build/linux",
            "inherits": "debug_base"
        },
        {
            "name": "release_amd64",
            "displayName": "Release AMD64",
            "description": "Release build for AMD64 architecture",
            "binaryDir": "${sourceDir}/build/linux",
            "inherits": "release_base"
        },
        {
            "name": "debug_amd64_windows",
            "displayName": "Debug AMD64 Windows",
            "description": "Cross-Compiled Debug build for Windows on AMD64 architecture",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "${sourceDir}/cmake/mingw-windows-toolchain.cmake",
            "inherits": "debug_base"
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release AMD64 Windows",
            "description": "Cross-Compiled Release build for Windows on AMD64 architecture",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "${sourceDir}/cmake/mingw-windows-toolchain.cmake",
            "inherits": "release_base"
        }
    ],
    "packagePresets": [
        {
            "name": "release_amd64",
            "displayName": "Release AMD64",
            "configurePreset": "release_amd64",
            "generators": [
                "TGZ",
                "AppImage"
            ],
            "variables": {
                "CPACK_PACKAGE_ICON": "zimo_logo.svg"
            }
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release AMD64 Windows",
            "configurePreset": "release_amd64_windows",
            "generators": [
                "NSIS",
                "ZIP"
            ],
            "variables": {
                "CPACK_NSIS_MODIFY_PATH": "OFF",
                "CPACK_NSIS_DISPLAY_NAME": "z-klaus",
                "CPACK_NSIS_PACKAGE_NAME": "z-klaus",
                "CPACK_NSIS_MUI_ICON": "${sourceDir}/data/zimo_logo.ico",
                "CPACK_NSIS_MUI_UNIICON": "${sourceDir}/data/zimo_logo.ico",
                "CPACK_NSIS_CREATE_ICONS_EXTRA": "CreateShortCut '$SMPROGRAMS\\\\z-klaus\\\\KLAUS.lnk' '$INSTDIR\\\\bin\\\\z-klaus.exe'",
                "CPACK_NSIS_DELETE_ICONS_EXTRA": "Delete '$SMPROGRAMS\\\\z-klaus\\\\KLAUS.lnk'",
                "CPACK_NSIS_EXTRA_INSTALL_COMMANDS": "CreateShortCut '$DESKTOP\\\\KLAUS.lnk' '$INSTDIR\\\\bin\\\\z-klaus.exe'",
                "CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS": "Delete '$DESKTOP\\\\KLAUS.lnk'"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release_amd64",
            "displayName": "Release AMD64",
            "configurePreset": "release_amd64"
        },
        {
            "name": "release_amd64_windows",
            "displayName": "Release AMD64 Windows",
            "configurePreset": "release_amd64_windows"
        }
    ],
    "workflowPresets": [
        {
            "name": "build-and-pack-linux",
            "description": "Builds and packs the Linux version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release_amd64"
                },
                {
                    "type": "build",
                    "name": "release_amd64"
                },
                {
                    "type": "package",
                    "name": "release_amd64"
                }
            ]
        },
        {
            "name": "build-and-pack-windows",
            "description": "Builds and packs the Windows version of this tool",
            "steps": [
                {
                    "type": "configure",
                    "name": "release_amd64_windows"
                },
                {
                    "type": "build",
                    "name": "release_amd64_windows"
                },
                {
                    "type": "package",
                    "name": "release_amd64_windows"
                }
            ]
        }
    ]
}