import {
    Button,
    VerticalBox,
    GridBox,
    CheckBox,
    HorizontalBox,
    SpinBox,
} from "std-widgets.slint";
import { CvProgrammingPage } from "cv-programming.slint";
import { UpdatePage } from "update.slint";
import { Cv } from "cv/cv.slint";

export component AppWindow inherits Window {
    in property update-page-progress-title-text <=> update.progress-title-text;
    in property update-page-progress-step-text <=> update.progress-step-text;
    in property update-page-progress-progress <=> update.progress-progress;

    callback update-choose-clicked <=> update.choose-clicked;
    callback update-start-clicked <=> update.start-clicked;
    callback update-abort-clicked <=> update.abort-clicked;

    HorizontalLayout {
        update := UpdatePage { }
    }
}
