import { FirmwareAdapter } from "firmware.slint";
import { HorizontalBox, CheckBox } from "std-widgets.slint";

export component FirmwareEntry {
    in property <string> name: "MS9000";
    in property <string> id: "0.0.0.0";
    in property <string> version: "0.0";

    in property <bool> is-even: true;
    in property <bool> show-box: true;

    callback selected(bool);

    Rectangle {
        background: is-even ? white : lightgray;
        max-width: 300px;

        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            padding: 5px;

            select := CheckBox {
                visible: root.show-box;
                changed checked => root.selected(self.checked);
            }

            name-text := Text {
                text: root.name;
                width: 80px;
            }

            id-text := Text {
                text: root.id;
                width: 100px;
            }

            version-text := Text {
                text: root.version;
                width: 100px;
            }
        }
    }
}
