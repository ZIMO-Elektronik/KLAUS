import { VerticalBox, Palette } from "std-widgets.slint";
import { UpdateInfo, FileType, FirmwareType } from "update-info.slint";
export component UpdateInfoPanel inherits Rectangle {
    in property <UpdateInfo> update-info;

    private property <string> file-type: update-info.file-type == FileType.Local ? @tr("Local") : @tr("Official");
    private property <string> firmware-type: update-info.firmware-type == FirmwareType.MS-MN-FS ? "MS-MN-FS" : "MX";

    VerticalLayout {
        height: 100%;

        alignment: LayoutAlignment.start;

        Rectangle {
            background: Palette.alternate-background;

            VerticalLayout {
                alignment: start;
                padding: 12px;
                Text {
                    text: @tr("Update information");
                    font-size: 20px;
                }

                VerticalBox {
                    padding: 16px;

                    Text {
                        text: file-type + " " + firmware-type;
                        font-italic: true;
                    }

                    if update-info.file-type == FileType.Local: Text {
                        text: @tr("File: {}", update-info.file-name);
                        font-italic: true;
                    }

                    Text {
                        text: @tr("Version: {}", update-info.version-major + "." + update-info.version-minor);
                        font-italic: true;
                    }
                }
            }
        }
    }
}
