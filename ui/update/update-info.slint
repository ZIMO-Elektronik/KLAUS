export enum FileType { Local, Online }
export enum FirmwareType { MS-MN-FS, MX }
export struct UpdateInfo {
    file-type: FileType,
    firmware-type: FirmwareType,
    file-name: string,
    version-major: int,
    version-minor: int,
    version-patch: int,
    version-extension: string,
}
