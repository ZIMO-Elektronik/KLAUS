import {
    Button,
    VerticalBox,
    HorizontalBox,
    ProgressIndicator,
} from "std-widgets.slint";
import { ProgressViewContext } from "progress_context.slint";

export component ProgressPanel {
    in property step <=> ProgressViewContext.step;
    in property progress <=> ProgressViewContext.progress;
    in property time-estimate <=> ProgressViewContext.time-estimate;

    callback abort-clicked();

    Rectangle {
        background: #f0f0f0;
        border-radius: 4px;
        border-width: 1px;
        border-color: #cccccc;

        min-width: 300px;

        VerticalBox {
            spacing: 10px;
            padding: 15px;

            Text {
                text: root.step;
                font-size: 14px;
                font-weight: 700;
                color: #333333;
            }

            HorizontalLayout {
                alignment: LayoutAlignment.space-between;

                width: 100%;
                preferred-height: progress-text.preferred-height + 5px;

                ProgressIndicator {
                    progress <=> root.progress;
                    width: 90%;
                    preferred-height: progress-text.preferred-height + 5px;
                }

                progress-text := Text {
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: Math.round(root.progress * 100) + "%";
                }
            }

            Text {
                text: "Estimated time remaining: " + root.time-estimate;
            }

            HorizontalBox {
                alignment: end;
                Button {
                    text: "Abort";
                    clicked => {
                        root.abort-clicked();
                    }
                }
            }
        }
    }
}
